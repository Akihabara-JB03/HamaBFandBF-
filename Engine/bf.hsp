#include "hspext.as"

title "HamaBF GUI Frontend"
screen 0, 640, 480

// タイトルラベル
pos 20, 10 : objsize 600, 20
mes "HamaBF コード入力 (拡張命令対応):"

// 1. Brainfuckコード入力ボックス
pos 20, 30 : objsize 600, 150
bf_code = "+^^^^^^+." // 初期値としてExampleの「A」を入れておく
mesbox bf_code, 600, 150, 1

// 2. 実行オプション（デバッグモード切り替え）
pos 20, 190
chkbox "デバッグモード (-debug)", debug_flag

// 3. 実行ボタン
pos 20, 220 : objsize 120, 30
button "HamaBF 実行", *run_hambf

// 結果表示ラベル
pos 20, 260
mes "実行結果出力:"

// 4. 結果表示ボックス
pos 20, 280 : objsize 600, 180
cmd_out = ""
mesbox cmd_out, 600, 180, 0

stop

*run_hambf
    // 一時ファイルにBrainfuckコードを書き出す
    notesel bf_code
    notesave "temp_code.bf"
    
    // コマンドライン引数の組み立て
    cmd_option = "-nodebug"
    if debug_flag == 1 : cmd_option = "-debug"
    cmd_line = "brainfuck.exe temp_code.bf " + cmd_option
    
    // HamaBFを非表示・パイプ実行
    pipeexec cmd_out, cmd_line, 0
    
    // 実行完了まで待機
    repeat
        pipeget cmd_out
        if stat == 0 : break
        await 10
    loop
    
    // 結果を画面のテキストボックスに反映
    objprm 3, cmd_out
    stop
