#include "hspext.as"
goto *init 
*run_hamabf // ← *run_hamabf に修正
    // 一時ファイルにBrainfuckコードを書き出す
    notesel bf_code
    notesave "temp_code.bf"
    
    // コマンドライン引数の組み立て
    cmd_option = "-nodebug"
    if debug_flag == 1 : cmd_option = "-debug"
    cmd_line = "brainfuck.exe temp_code.bf " + cmd_option
    
    // HamaBFを非表示・パイプ実行
    pipeexec cmd_out, cmd_line, 0
    
    // 実行完了まで待機しつつ、リアルタイムに画面を更新
    repeat
        pipeget cmd_out
        objprm 3, cmd_out // ループの中で常に最新の状態に書き換える
        if stat == 0 : break
        await 30 // C言語側の出力速度に合わせて少し待つ
    loop
    stop
*init
	title "BF GUI Frontend"
	screen 0, 640, 480

	// タイトルラベル
	pos 20, 10 : objsize 600, 20
	mes "BF コード入力:"

	// 1. Brainfuckコード入力ボックス
	pos 20, 30 : objsize 600, 150
	bf_code = ""
	mesbox bf_code, 600, 150, 1

	// 2. 実行オプション（デバッグモード切り替え）
	pos 20, 190
	chkbox "デバッグモード (-debug)", debug_flag

	// 3. 実行ボタン
	pos 20, 220 : objsize 120, 30
	button "BF 実行", *run_hamabf // ← *run_hamabf に修正

	// 結果表示ラベル
	pos 20, 260
	mes "実行結果出力:"

	// 4. 結果表示ボックス
	pos 20, 280 : objsize 600, 180
	cmd_out = ""
	mesbox cmd_out, 600, 180, 0

	stop
